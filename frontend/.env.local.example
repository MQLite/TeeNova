# Environment configuration — use environment-specific files instead of .env.local:
#
#   .env.development.local   loaded by `next dev`   (local machine)
#   .env.production.local    loaded by `next start`  (production server)
#
# Both files are gitignored (.env.*.local). Copy the matching .example file and fill in values.
# See .env.production.local.example for the production template.

# ── Development (.env.development.local) ──────────────────────────────────────

# In dev, server-side and browser both hit the same local backend — one URL is enough.
# BACKEND_URL is not needed; both sides fall back to NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_BASE_URL=https://localhost:44300

# General quote form (Jira 10301). Keep disabled until backend storage, retention, email routing,
# privacy copy and business contact details are approved. NEXT_PUBLIC_* changes require a rebuild.
NEXT_PUBLIC_QUOTE_FORM_ENABLED=false
NEXT_PUBLIC_PORTFOLIO_ENABLED=false
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_BUSINESS_PHONE=(09) 270 3378
NEXT_PUBLIC_BUSINESS_MOBILE=027 276 7379
NEXT_PUBLIC_MESSENGER_URL=
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Privacy-enquiry mailbox (Jira 10303). Both otahuhuprint@gmail.com and qualitycanvasltd@gmail.com are
# valid business addresses; which one handles privacy enquiries is not decided, so this is left blank
# and falls back to NEXT_PUBLIC_CONTACT_EMAIL. Set it once the owner assigns the role.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=

# Public website origin (Jira 10308). Optional in development: when it is blank, the SEO layer falls
# back to http://localhost:3000 so canonicals, the sitemap and JSON-LD have a stable local origin.
# That fallback is refused in production — see .env.production.local.example, where the value is
# required and the canonical production domain is still an open approval (A44).
NEXT_PUBLIC_SITE_URL=

# Allow Node.js to accept the .NET self-signed dev certificate.
# NEVER set this on the production server.
NODE_TLS_REJECT_UNAUTHORIZED=0

# ── Production (.env.production, on the server) ────────────────────────────────
#
# BACKEND_URL=http://localhost:5100          ← server-side only, bypasses nginx
# NEXT_PUBLIC_API_BASE_URL=https://www.otahuhuprint.com  ← browser image/API URLs
# NEXT_PUBLIC_APP_NAME=Otahuhu Printing Shop
