# Copy this file to .env.production on the production server and fill in values.
# Loaded by Next.js only when NODE_ENV=production (i.e. `next start`).

# Direct backend address — only visible to the Node.js process, never sent to the browser.
# Server-side code (SSR pages, route handlers, proxy) uses this to bypass nginx.
BACKEND_URL=http://localhost:5100

# Public domain — used by browser-side code for image URLs and public API calls.
# This goes through nginx, so nginx must be able to reach the backend.
NEXT_PUBLIC_API_BASE_URL=https://www.otahuhuprint.com

NEXT_PUBLIC_APP_NAME=Otahuhu Printing Shop

# ── Public website origin (Jira 10308) ────────────────────────────────────────
#
# The canonical address of the WEBSITE. Everything the site publishes about itself — canonical URLs,
# Open Graph URLs, sitemap entries, the Sitemap: line in robots.txt and every JSON-LD @id — is built
# from this one value.
#
# It is deliberately separate from NEXT_PUBLIC_API_BASE_URL above. The two happen to be the same host
# in the current deployment, which is exactly why the SEO layer must not read the API variable: the
# day the API moves to api.otahuhuprint.com the canonicals would silently follow it.
#
# CONFIRMED: production is deployed at this canonical domain (Jira 10300 A44). Keep this value in
# the real production build environment so canonicals, sitemap, robots and JSON-LD stay enabled.
#
# Must be an absolute https:// origin with no path, query, fragment or credentials.
NEXT_PUBLIC_SITE_URL=https://www.otahuhuprint.com

# Set to "false" on a production-mode deployment that is NOT the live site (staging, a preview host).
# Forces robots.txt to disallow everything and suppresses the sitemap reference. Leave blank on live.
NEXT_PUBLIC_SEO_INDEXING_ENABLED=true

# ── Business facts released into structured data (Jira 10308) ─────────────────
#
# These gates control machine-readable claims only. A JSON-LD business node is what a search engine
# reproduces in a knowledge panel, so a wrong opening hour there sends a customer to a locked door —
# a stronger consequence than the same words in page copy. Every gate is off by default and each one
# corresponds to an open approval in the Jira 10300 register.
#
# A01/A02 — the official public business name. Until this is "true" no Organization or LocalBusiness
# node is published at all, and Service nodes carry no provider.
NEXT_PUBLIC_BUSINESS_IDENTITY_APPROVED=
# A07 — the street address as a published NAP fact. Required, with the identity, before any node.
NEXT_PUBLIC_BUSINESS_ADDRESS_APPROVED=
# A09 — opening hours as openingHoursSpecification.
NEXT_PUBLIC_BUSINESS_HOURS_APPROVED=
# Mailbox-role assignment: which confirmed address is THE public contact address. Only
# otahuhuprint@gmail.com and qualitycanvasltd@gmail.com are accepted.
NEXT_PUBLIC_PUBLIC_EMAIL_ROLE_APPROVED=

# Address components. Defaults match the address the site already displays; override only to correct
# it. The visible line and the structured PostalAddress are both generated from these.
NEXT_PUBLIC_BUSINESS_STREET_ADDRESS=
NEXT_PUBLIC_BUSINESS_LOCALITY=
NEXT_PUBLIC_BUSINESS_REGION=
NEXT_PUBLIC_BUSINESS_POSTAL_CODE=
NEXT_PUBLIC_BUSINESS_COUNTRY=

# A10 — approved service areas, comma-separated. Never inferred from "the shop is in Auckland".
NEXT_PUBLIC_BUSINESS_AREA_SERVED=
# schema.org priceRange (e.g. "$$"). Omitted unless explicitly approved.
NEXT_PUBLIC_BUSINESS_PRICE_RANGE=
# A34 — absolute or site-relative URL of an APPROVED logo. The app icon and favicon are documented
# placeholders and are never published as the business's logo, so leave this blank until one exists.
NEXT_PUBLIC_BRAND_LOGO_URL=

# ── Verified social and profile URLs (A27/A28/A39/A40) ────────────────────────
#
# One source for both the footer links and JSON-LD sameAs. Each value must be an absolute https URL
# on the platform's own domain and must identify a specific profile — a platform homepage is
# rejected. A blank or invalid value renders nothing at all: no chip, no inert label, no "#".
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_GOOGLE_BUSINESS_PROFILE_URL=
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# ── Search-engine ownership verification ──────────────────────────────────────
#
# Real tokens only. A sample-looking value emits a meta tag claiming ownership of a property nobody
# has verified. Setting these emits the tag and nothing else — no external API is called, and no
# property is verified by the application.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# General quote form (Jira 10301). Enable only after the production-readiness checklist passes.
# These are build-time public values; changing them requires rebuilding the frontend.
NEXT_PUBLIC_QUOTE_FORM_ENABLED=false
NEXT_PUBLIC_PORTFOLIO_ENABLED=false
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_BUSINESS_PHONE=
NEXT_PUBLIC_WHATSAPP_NUMBER=
# Privacy-enquiry mailbox (Jira 10303). Both otahuhuprint@gmail.com and qualitycanvasltd@gmail.com are
# valid; the mailbox roles are not assigned yet, so this stays blank and falls back to the contact
# address above.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=
