# Copy this file to .env.production.local on the production server and fill in values.
# .env.production.local is gitignored — never commit it.
# Loaded by Next.js only when NODE_ENV=production (i.e. `next start`).

# Backend URL as seen from the Next.js process on the same server.
# ASP.NET Core binds to localhost:5100 (HTTP) — no TLS needed for loopback traffic.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5100
