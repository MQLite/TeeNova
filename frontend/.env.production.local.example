# Copy this file to .env.production on the production server and fill in values.
# Loaded by Next.js only when NODE_ENV=production (i.e. `next start`).

# Direct backend address — only visible to the Node.js process, never sent to the browser.
# Server-side code (SSR pages, route handlers, proxy) uses this to bypass nginx.
BACKEND_URL=http://localhost:5100

# Public domain — used by browser-side code for image URLs and public API calls.
# This goes through nginx, so nginx must be able to reach the backend.
NEXT_PUBLIC_API_BASE_URL=https://www.otahuhuprint.com

NEXT_PUBLIC_APP_NAME=Otahuhu Printing Shop
